{
  "name": "tunnel-app-deployer",
  "version": "0.2.0",
  "description": "Share a local Docker application through a temporary HTTPS link.",
  "main": "src/main.js",
  "author": "Ding-Ding-Projects",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/desktop/*.test.js tests/backend/*.test.js",
    "test:desktop": "node --test tests/desktop/*.test.js",
    "test:backend": "node --test tests/backend/*.test.js",
    "content": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check",
    "vendor": "node scripts/vendor-assets.mjs",
    "build-info": "node scripts/write-build-info.mjs",
    "package:win": "electron-builder --win squirrel --x64",
    "clip": "node scripts/screens/clip-matrix.js",
    "audit:ui": "node scripts/screens/ui-audit.js"
  },
  "devDependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "axe-core": "4.14.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "material-symbols": "0.48.3"
  },
  "build": {
    "appId": "com.dingdingprojects.tunnelappdeployer",
    "productName": "Tunnel App Deployer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "squirrel"
      ],
      "icon": "build/icon.ico"
    },
    "squirrelWindows": {
      "artifactName": "Tunnel-App-Deployer-Setup-${version}.${ext}",
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/tunnel-app-deployer/a16a28c06f0c23505bb2eadd919fe5920efa0d2f/build/icon.ico",
      "useAppIdAsId": false
    }
  }
}
